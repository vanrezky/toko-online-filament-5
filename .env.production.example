# Copy these keys into the GitHub production Environment as individual values.
# The deployment workflow renders .env.production; do not create a PRODUCTION_ENV blob.

APP_NAME=TokoOnline
APP_ENV=production
APP_KEY=base64:replace-with-the-existing-production-key
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_STDERR_FORMATTER=Monolog\\Formatter\\JsonFormatter

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=toko_online
DB_USERNAME=toko_online
DB_PASSWORD=replace-with-the-application-database-password
DB_ROOT_PASSWORD=replace-with-a-different-mysql-root-password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Leave empty for the default stack. Set to redis only when Redis is enabled.
COMPOSE_PROFILES=
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# FrankenPHP serves HTTP(S) directly; no Nginx or host PHP-FPM is required.
OCTANE_SERVER=frankenphp
OCTANE_HOST=example.com
OCTANE_PORT=443
OCTANE_HTTPS=true
OCTANE_ADMIN_PORT=2019
OCTANE_WORKERS=1
OCTANE_MAX_REQUESTS=500
OCTANE_LOG_LEVEL=warn

# These values are rendered into PHP's OPcache INI at every container start.
OPCACHE_ENABLE=1
OPCACHE_ENABLE_CLI=1
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_INTERNED_STRINGS_BUFFER=16
OPCACHE_MAX_ACCELERATED_FILES=20000
OPCACHE_VALIDATE_TIMESTAMPS=0
OPCACHE_REVALIDATE_FREQ=0
OPCACHE_SAVE_COMMENTS=1
OPCACHE_JIT=off
OPCACHE_JIT_BUFFER_SIZE=0

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=TokoOnline

# Use R2 by setting FILESYSTEM_DISK or R2_UPLOAD_DISK to the intended disk.
R2_UPLOAD_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_REQUEST_TIMEOUT=30
APICOID_API_KEY=
APICOID_BASE_URL=https://api.co.id

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://example.com/auth/github/callback

HEALTH_DB_CONNECTION=mysql
HEALTH_REDIS_CONNECTION=default
HEALTH_QUEUE_NAME=default
HEALTH_QUEUE_FAILURE_MINUTES=5
HEALTH_DISK_WARNING_PERCENTAGE=70
HEALTH_DISK_FAILURE_PERCENTAGE=90
HEALTH_RESULT_HISTORY_DAYS=5
HEALTH_NOTIFICATIONS_ENABLED=false
HEALTH_TO_ADDRESS=no-reply@example.com
HEALTH_FROM_ADDRESS=no-reply@example.com
HEALTH_FROM_NAME=TokoOnline
HEALTH_SECRET_TOKEN=

AUDIT_LOGGER_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=180
AUDIT_LOG_PRUNING_ENABLED=false
ACTIVITY_LOGGER_TABLE_NAME=activity_log
INTEGRATION_LOG_PAYLOAD_MAX_BYTES=65536
INTEGRATION_LOG_RETENTION_DAYS=90

FILAMENT_FILESYSTEM_DISK=public
BCRYPT_ROUNDS=12
SETTINGS_CACHE_ENABLED=true
VITE_APP_NAME=TokoOnline
